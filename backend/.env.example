SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://your-rds-endpoint:5432/kante_elite
DB_USERNAME=postgres
DB_PASSWORD=change-me

JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-cloudfront-domain.cloudfront.net
FRONTEND_URL=https://your-frontend-domain.com

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Kante Elite Admin

APP_PAYMENTS_ENABLED=false
APP_UPLOADS_DIR=/opt/kante-elite/uploads
APP_EMAIL_ENABLED=false
APP_EMAIL_FROM=noreply@yourdomain.com
APP_EMAIL_ADMIN=admin@yourdomain.com

SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
